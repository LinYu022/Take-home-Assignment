# Use either DATA_ROOT or the S3-compatible settings below.
DATA_ROOT=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
PUBLIC_BASE_URL=http://127.0.0.1:8000
LEROBOT_CACHE_DIR=
MAX_RENDER_WIDTH=1600
MAX_RENDER_HEIGHT=1200
MAX_QUERY_ROWS=256
MAX_QUERY_SCALARS=4096
MAX_QUERY_BYTES=128000
# Audit budgets may be reduced, not raised above these service hard caps.
MAX_AUDIT_ROWS=8192
MAX_AUDIT_SCALARS=1000000
MAX_VIEW_URL_CHARS=16384
MAX_AGGREGATE_ROWS=1000000
MAX_IMAGE_BYTES=2097152
MCP_ALLOWED_ORIGINS=
HOST=127.0.0.1
PORT=8000

